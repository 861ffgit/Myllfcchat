    background: transparent;
    width: 6px;
    margin: 10px 2px 10px 0;
}

QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.18);
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {

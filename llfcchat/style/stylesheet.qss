QDialog#LoginDialog {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #dff3e5,
                                      stop: 0.5 #f5fbf7,
                                      stop: 1 #d8eedf);
}

QDialog#RegisterDialog {
    background-color: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                      stop: 0 #dff3e5,
                                      stop: 0.5 #f5fbf7,
                                      stop: 1 #d8eedf);
}

#ResetDialog {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
                                stop: 0 #ffdcbf,
                                stop: 0.5 #ffeddc,
                                stop: 1 #ffd4ad);
}

#login_card {
    background-color: rgba(255, 255, 255, 244);
    border: 1px solid rgba(180, 214, 191, 0.75);
    border-radius: 26px;
}

#register_card,
#success_card {
    background-color: rgba(255, 255, 255, 244);
    border: 1px solid rgba(180, 214, 191, 0.75);
    border-radius: 26px;
}

#reset_card {
    background-color: rgba(255, 255, 255, 244);
    border: 1px solid rgba(244, 206, 184, 0.95);
    border-radius: 26px;
}

#LoginDialog QLabel {
    background: transparent;
}

#RegisterDialog QLabel {
    background: transparent;
}

#ResetDialog QLabel {
    background: transparent;
}

#head_widget {
    background: transparent;
    border: none;
    border-radius: 52px;
}

#head_label {
    background: transparent;
}

#title_label {
    color: #2d5a3d;
    font-size: 16px;
    font-weight: 500;
    font-family: 'Microsoft YaHei';
    margin-top: 0px;
}

#subtitle_label {
    color: transparent;
    font-size: 1px;
    max-height: 0px;
}

#user_label,#pass_label{
   color:black;
}

#err_tip[state='normal']{
   color: green;
}

#err_tip[state='err']{
   color: red;
}


#pass_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

#pass_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

#pass_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

#pass_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

#LoginDialog #pass_visible[state='unvisible'],
#LoginDialog #pass_visible[state='visible'] {
    background: transparent;
    padding: 2px;
}

#LoginDialog #pass_visible[state='unvisible_hover'],
#LoginDialog #pass_visible[state='visible_hover'] {
    background: rgba(160, 207, 176, 0.2);
    border-radius: 11px;
    padding: 2px;
}


#confirm_visible[state='unvisible']{
   border-image: url(:/res/unvisible.png);
}

#confirm_visible[state='unvisible_hover']{
   border-image: url(:/res/unvisible_hover.png);
}

#confirm_visible[state='visible']{
   border-image: url(:/res/visible.png);
}

#confirm_visible[state='visible_hover']{
   border-image: url(:/res/visible_hover.png);
}

#tip_lb, #tip2_lb{
    color:green;
}

#forget_label[state='normal'],#forget_label[state='selected']{
    color:black;
}

#forget_label[state='hover'], #forget_label[state='selected_hover']{
    color: rgb(42, 112, 241);
}

#LoginDialog #email_lb,
#LoginDialog #pass_label {
    color: #4d725d;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Microsoft YaHei';
    padding-left: 2px;
}

#LoginDialog #email_edit,
#LoginDialog #pass_edit {
    color: #244131;
    selection-background-color: #b9dec4;
    font-size: 13px;
    font-family: 'Microsoft YaHei';
}

#LoginDialog #email_edit::placeholder,
#LoginDialog #pass_edit::placeholder {
    color: #97b4a1;
}

#pass_row {
    background: transparent;
}

#LoginDialog #err_tip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
    min-height: 28px;
    max-height: 28px;
    padding: 0 8px;
    margin: 0 0 2px 0;
}

#LoginDialog #err_tip:empty {
    border: none;
    background: transparent;
    color: transparent;
}

#LoginDialog #err_tip[state='empty'] {
    border: none;
    background: transparent;
    color: transparent;
}

#LoginDialog #err_tip[state='normal'] {
    color: #2f8f5b;
    border: 1px solid rgba(47, 143, 91, 0.18);
    background: rgba(235, 248, 240, 0.9);
}

#LoginDialog #err_tip[state='err'] {
    color: #cb5a4d;
    border: 1px solid rgba(203, 90, 77, 0.18);
    background: rgba(255, 241, 239, 0.92);
}

#LoginDialog #forget_label[state='normal'],
#LoginDialog #forget_label[state='selected'] {
    color: #6b9278;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
}

#LoginDialog #forget_label[state='hover'],
#LoginDialog #forget_label[state='selected_hover'] {
    color: #4f9a69;
}

#LoginDialog #login_btn,
#LoginDialog #reg_btn {
    font-size: 14px;
    font-family: 'Microsoft YaHei';
    border-radius: 14px;
}

#RegisterDialog #register_title {
    color: #2d5a3d;
    font-size: 18px;
    font-weight: 600;
    font-family: 'Microsoft YaHei';
    margin-top: 2px;
}

#RegisterDialog #register_subtitle {
    color: #7b9a87;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
    margin-bottom: 2px;
}

#RegisterDialog #user_label,
#RegisterDialog #email_label,
#RegisterDialog #pass_label,
#RegisterDialog #confirm_label,
#RegisterDialog #varify_label {
    color: #4d725d;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Microsoft YaHei';
    padding-left: 2px;
}

#RegisterDialog #user_edit,
#RegisterDialog #email_edit,
#RegisterDialog #pass_edit,
#RegisterDialog #confirm_edit,
#RegisterDialog #varify_edit {
    color: #244131;
    selection-background-color: #b9dec4;
    font-size: 13px;
    font-family: 'Microsoft YaHei';
}

#RegisterDialog #user_edit::placeholder,
#RegisterDialog #email_edit::placeholder,
#RegisterDialog #pass_edit::placeholder,
#RegisterDialog #confirm_edit::placeholder,
#RegisterDialog #varify_edit::placeholder {
    color: #97b4a1;
}

#RegisterDialog #user_row,
#RegisterDialog #email_row,
#RegisterDialog #pass_row,
#RegisterDialog #confirm_row,
#RegisterDialog #verify_row {
    background: transparent;
}

#RegisterDialog #err_tip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
    min-height: 28px;
    max-height: 28px;
    padding: 0 8px;
    margin: 0 0 2px 0;
}

#RegisterDialog #err_tip:empty,
#RegisterDialog #err_tip[state='empty'] {
    border: none;
    background: transparent;
    color: transparent;
}

#RegisterDialog #err_tip[state='normal'] {
    color: #2f8f5b;
    border: 1px solid rgba(47, 143, 91, 0.18);
    background: rgba(235, 248, 240, 0.9);
}

#RegisterDialog #err_tip[state='err'] {
    color: #cb5a4d;
    border: 1px solid rgba(203, 90, 77, 0.18);
    background: rgba(255, 241, 239, 0.92);
}

#RegisterDialog #pass_visible[state='unvisible'],
#RegisterDialog #confirm_visible[state='unvisible'],
#RegisterDialog #pass_visible[state='visible'],
#RegisterDialog #confirm_visible[state='visible'] {
    background: transparent;
    padding: 2px;
}

#RegisterDialog #pass_visible[state='unvisible_hover'],
#RegisterDialog #confirm_visible[state='unvisible_hover'],
#RegisterDialog #pass_visible[state='visible_hover'],
#RegisterDialog #confirm_visible[state='visible_hover'] {
    background: rgba(160, 207, 176, 0.2);
    border-radius: 9px;
    padding: 2px;
}

#RegisterDialog #sure_btn,
#RegisterDialog #cancel_btn,
#RegisterDialog #return_btn {
    font-size: 14px;
    font-family: 'Microsoft YaHei';
    border-radius: 14px;
}

#RegisterDialog #get_code {
    color: #ffffff;
    font-size: 14px;
    font-family: 'Microsoft YaHei';
}

#RegisterDialog #sure_btn,
#RegisterDialog #return_btn {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #8ec8a0,
                                stop: 1 #6faf84);
    color: #ffffff;
    border: none;
}

#RegisterDialog #sure_btn:hover,
#RegisterDialog #return_btn:hover {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #9bd0ac,
                                stop: 1 #79ba8e);
}

#RegisterDialog #sure_btn:pressed,
#RegisterDialog #return_btn:pressed {
    background: #63a379;
}

#RegisterDialog #sure_btn:disabled,
#RegisterDialog #return_btn:disabled {
    background: #c7e1cf;
    color: rgba(255, 255, 255, 0.78);
}

#RegisterDialog #cancel_btn {
    background: #ffffff;
    color: #4f7c60;
    border: 1px solid #cfe3d4;
}

#RegisterDialog #cancel_btn:hover {
    background: #f4fbf6;
    border: 1px solid #b6d7c0;
}

#RegisterDialog #cancel_btn:pressed {
    background: #edf6ef;
}

#RegisterDialog #tip_lb {
    color: #2d5a3d;
    font-size: 18px;
    font-weight: 600;
    font-family: 'Microsoft YaHei';
}

#RegisterDialog #tip2_lb {
    color: #7b9a87;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
}

#ResetDialog #reset_title {
    color: #b76d45;
    font-size: 18px;
    font-weight: 600;
    font-family: 'Microsoft YaHei';
    margin-top: 2px;
}

#ResetDialog #reset_subtitle {

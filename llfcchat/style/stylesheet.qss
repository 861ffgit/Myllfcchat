}

#ResetDialog #err_tip[state='normal'] {
    color: #b16f4c;
    border: 1px solid rgba(177, 111, 76, 0.16);
    background: rgba(255, 245, 238, 0.96);
}

#ResetDialog #err_tip[state='err'] {
    color: #cb5a4d;
    border: 1px solid rgba(203, 90, 77, 0.18);
    background: rgba(255, 241, 239, 0.92);
}

#ResetDialog #varify_btn {
    color: #ffffff;

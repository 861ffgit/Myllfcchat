    font-family: 'Microsoft YaHei';
}

#ResetDialog #sure_btn,
#ResetDialog #return_btn {
    font-size: 14px;
    font-family: 'Microsoft YaHei';
    border-radius: 14px;
}

#ResetDialog #sure_btn {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
                                stop: 0 #efb28d,
                                stop: 1 #de996d);

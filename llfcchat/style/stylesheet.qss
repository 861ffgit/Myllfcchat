    color: #c3a390;
}

#ResetDialog #verify_row {
    background: transparent;
}

#ResetDialog #err_tip {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    font-size: 12px;
    font-family: 'Microsoft YaHei';
    min-height: 28px;
    max-height: 28px;
    padding: 0 8px;

/* === chat polish start === */
QDialog#ChatDialog {
    background: #edf1f4;
}

QWidget#side_bar {
    background-color: #2c3138;
    border-right: 1px solid #252a30;
}

#side_head_lb {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 10px;
}

QWidget#chat_user_wid,
QWidget#search_wid {
    background: #f3f5f7;
}

QWidget#chat_user_wid {
    border: none;
}

QWidget#search_wid {
    border-bottom: 1px solid #e3e8ed;
}

#search_edit {
    background: transparent;
    border: none;
    color: #333333;
    font-size: 13px;
    font-family: "Microsoft YaHei";
    padding: 0 12px;
    selection-background-color: #d6f0df;
}

#search_edit:focus {
    border: none;
    background: transparent;
}

QWidget#search_wid #add_btn[state='normal'] {
    background: #f7f8fa;
    border: 1px solid #e4e7eb;
    border-radius: 8px;
    padding: 4px;
}

QWidget#search_wid #add_btn[state='hover'] {
    background: #ffffff;
    border: 1px solid #d9dde2;
    border-radius: 8px;
    padding: 4px;
}

QWidget#search_wid #add_btn[state='press'] {
    background: #eef2f5;
    border: 1px solid #d8dde3;
    border-radius: 8px;
    padding: 4px;
}

#chat_user_list,
#con_user_list,
#search_list {
    background-color: #f3f5f7;
    border: none;
    outline: none;
    padding: 8px 4px;
}

#chat_user_list::item,
#con_user_list::item,
#search_list::item {
    margin: 4px 8px;
    border-radius: 8px;
}

#chat_user_list::item:selected,
#con_user_list::item:selected,
#search_list::item:selected {
    background-color: transparent;
    border: none;
    outline: none;
}

#chat_user_list::item:hover,
#con_user_list::item:hover,
#search_list::item:hover {
    background-color: transparent;
    border: none;
    outline: none;
}

